{
  "languages": {
    "Markdown": {
      "format_on_save": "off",
    },
  },

  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "rustfmt": {
          "extraArgs": [
            // "+nightly"
          ],
        },

        "check": {
          "allTargets": false,
        },

        // "check": {
        //   "noDefaultFeatures": true
        // },

        "showUnlinkedFileNotification": false,

        "cargo": {
          // Uncomment the target of your chip.
          // "target": "thumbv6m-none-eabi",
          // "target": "thumbv7m-none-eabi",
          // "target": "thumbv7em-none-eabi",
          // "target": "thumbv7em-none-eabihf",
          // "target": "thumbv8m.main-none-eabihf",

          "features": [
            "p256-ecdsa",
            "p384-ecdsa",

            // Comment out these features when working on the examples.
            // Most example crates do not have any cargo features.
            // "stm32f107rb",
            // "time-driver-any",
            // "unstable-pac",
            // "exti",
            // "rt",
            // "stm32f446re"
            // "esp-hosted-mcu"
            // "mimxrt1011"
            // "stm32f767zi"
            // "stm32f429zi"
            // "stm32h563zi"
            // "driver-rustcrypto"
            // "driver-p256"
          ],
        },

        "linkedProjects": [
          // "embassy-nxp/Cargo.toml"
          // "tests/stm32/Cargo.toml"
          // "embassy-stm32/Cargo.toml",
          // "embassy-crypto/Cargo.toml"
          // "embassy-net-esp-hosted/Cargo.toml"
          // To work on the examples, comment the line above and all of the
          // cargo.features lines, then uncomment ONE line below to select
          // the chip you want to work on.
          // This makes rust-analyzer work on the example crate and all its dependencies.
        ],
      },
    },
  },
}
